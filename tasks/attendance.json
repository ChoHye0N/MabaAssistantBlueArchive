                  "action": "if",
                  "when": {
                    "no_color": { "hsv_min": [0, 0, 235], "hsv_max": [180, 25, 255], "area": [5000, 7600], "roi": { "x": 300, "y": 8, "w": 250, "h": 30 } }
                  },
                  "then": [{ "action": "fail", "message": "the attendance book stayed covered after claiming" }]
                }
