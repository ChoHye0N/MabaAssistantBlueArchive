          { "action": "read_number", "roi": { "x": 500, "y": 8, "w": 105, "h": 30 }, "store": "ap", "optional": true },
          {
            "action": "if",
            "when": { "value": "ap", "lt": 20 },
            "then": [{"action": "break"}]
          },
          {
            "action": "if",
            "when": { "setting": "scrimmage_stage", "equals": "highest" },
            "then": [
              {
                "action": "click",
