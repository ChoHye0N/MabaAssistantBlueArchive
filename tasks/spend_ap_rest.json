              }
            ]
          },
          {
            "action": "if",
            "when": { "absent": { "template": "popup_stage_info_title.png", "roi": { "x": 540, "y": 70, "w": 200, "h": 110 }, "threshold": 0.9 } },
            "then": [{"action": "break"}]
          },
          {
            "action": "click",
            "template": "stage_sweep_max.png",
            "roi": { "x": 1030, "y": 265, "w": 120, "h": 105 },
            "threshold": 0.9,
            "no_verify": true
          },
          {
            "action": "click",
            "template": "stage_sweep_start.png",
            "roi": { "x": 770, "y": 370, "w": 330, "h": 100 },
            "threshold": 0.9,
            "expect": { "template": "stage_sweep_confirm_question.png", "roi": { "x": 400, "y": 280, "w": 480, "h": 110 }, "threshold": 0.9 },
            "timeout_ms": 3000,
            "retries": 0,
            "optional": true
          },
          {
            "action": "if",
            "when": { "present": { "template": "stage_sweep_confirm_question.png", "roi": { "x": 400, "y": 280, "w": 480, "h": 110 }, "threshold": 0.9 } },
            "then": [
              {
                "action": "click",
                "template": "dialog_ok_button.png",
                "roi": { "x": 660, "y": 440, "w": 240, "h": 120 },
