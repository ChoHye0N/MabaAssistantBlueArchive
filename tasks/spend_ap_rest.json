                "roi": { "x": 680, "y": 130, "w": 560, "h": 560 },
                "threshold": 0.9,
                "pick": "bottom",
                "offset": { "x": 397, "y": -16 },
                "expect": { "template": "popup_stage_info_title.png", "roi": { "x": 540, "y": 70, "w": 200, "h": 110 }, "threshold": 0.9 },
                "optional": true
              }
            ],
            "else": [
              {
                "action": "click_text",
                "text_setting": "scrimmage_stage",
                "roi": { "x": 690, "y": 130, "w": 90, "h": 560 },
                "click_x": 1117,
                "offset": { "x": 0, "y": 13 },
                "max_scrolls": 5,
                "duration_ms": 500,
                "optional": true,
                "from": { "x": 940, "y": 250 },
