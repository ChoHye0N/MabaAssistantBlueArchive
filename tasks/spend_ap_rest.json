{
  "id": "spend_ap_rest",
  "name": "Spend remaining AP (after mail)",
  "order": 100,
  "after": ["mail_claim_all"],
  "status": "wip",
  "needs_ocr": true,
  "notes": [
    "Second AP pass after mail_claim_all collected the AP held in the mailbox. Same steps and settings as spend_ap.",
    "AP goes to the targets in the order of the 'targets' setting: the running event (Story stages, then the highest 3-star Quest), campaign missions, scrimmage (uses its own tickets and AP).",
    "Event route: main screen -> campaign -> banner at the top left. The banner rotates; swipe right until the first dot is lit (colour check), then swipe left for banner 2 or 3, then click at once.",
    "An event without Story and Quest tabs (a settlement event) has no stages here: the target is skipped.",
    "An event whose play period ended still opens ('the event period has ended'): it is skipped.",
    "Uncleared event quests (grey stars) are played with the 'quest_team' team before the highest 3-star quest is swept. Campaign missions that are not cleared are grid maps and are not played yet (roadmap).",
    "Story stages are taken from the top 'Story' tag (cleared stages lose the tag). Story scenes are skipped like the owner's earlier project does: back opens the skip confirmation, which is confirmed (popups/story_*.json). Battles use the event's preset team with AUTO.",
    "Every player's progress differs, so stages are chosen on screen: 'highest' takes the highest stage with 3 stars; a number picks that stage (found with OCR while scrolling). Event bonuses depend on the students in the team, so the farmed quest and the team are settings.",
    "Sweeps use MAX and are confirmed only on the 'run the sweep?' question; any other dialog (for example an AP purchase offer) is closed with back. AP is read with OCR; below 20 AP the target is skipped."
  ],
  "settings": [
    {
      "key": "targets",
      "type": "list",
      "default": ["event", "mission", "scrimmage"],
      "choices": ["event", "mission", "scrimmage"],
      "description": "Where AP goes, highest priority first."
    },
    { "key": "event_banner", "type": "int", "default": 1, "min": 1, "max": 3, "description": "Which event banner to farm (1 = most recent)." },
    {
      "key": "event_story",
      "type": "bool",
      "default": true,
      "description": "Play the event's open story stages before the quests (story scenes are skipped)."
    },
    { "key": "clear_quests", "type": "bool", "default": true, "description": "Play the event's uncleared quests before sweeping." },
    {
      "key": "quest_team",
      "type": "int",
      "default": 1,
      "min": 1,
      "max": 4,
      "description": "Team (1-4) for playing event quests; set it up in the game beforehand (event students raise the bonus)."
    },
    {
      "key": "quest_stage",
      "type": "choice",
      "default": "highest",
      "choices": ["highest", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
      "description": "Event quest to farm: 'highest' (highest with 3 stars) or its number (01-12). A quest without 3 stars is played once with the team."
    },
    {
      "key": "mission_stage",
      "type": "choice",
      "default": "highest",
      "choices": ["highest", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
      "description": "Campaign mission stage of the shown area: 'highest' or its number."
    },
    {
      "key": "scrimmage_stage",
      "type": "choice",
      "default": "highest",
      "choices": ["highest", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
      "description": "Scrimmage stage: 'highest' or its number."
    },
    { "key": "academy", "type": "int", "default": 1, "min": 1, "max": 3, "description": "Scrimmage academy, top to bottom (1-3)." }
  ],
