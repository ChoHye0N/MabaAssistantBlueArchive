{
  "id": "spend_mission",
  "name": "Spend AP: campaign missions",
  "order": 75,
  "after": [],
  "status": "wip",
  "needs_ocr": true,
  "notes": [
    "Sweeps a stage of the campaign area shown when the page opens. Missions that are not cleared are grid maps and are not played yet (roadmap).",
    "Sweeps are confirmed only on the 'run the sweep?' question; any other dialog (for example an AP purchase offer) is closed with back. AP is read with OCR; below 20 AP the task is skipped.",
    "Batch sweep first (button at the bottom left of the mission page): the chosen preset tabs (1-7, counted from the left, because players rename them) run in order in one opened window. A tab is checked by its dark colour, the count is set with MIN and + or MAX, and the sweep runs only while its button is yellow (an empty preset or no runs left grey it). The 'sweep details' question is confirmed and the result closes as a popup. Hard stages allow 3 runs a day each. 'batch_only_campaign' skips it unless the mission page shows the campaign tag."
  ],
  "settings": [
    {
      "key": "batch_presets",
      "type": "list",
      "default": [],
      "choices": ["1", "2", "3", "4", "5", "6", "7"],
      "label_key": "mission.batch_preset.",
      "ui": "checklist",
      "description": "Batch sweep presets to run first, in order, counted from the left (players rename them). None = no batch sweep."
    },
    {
      "key": "batch_runs",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 3,
      "description": "Runs per stage in the batch sweep: 0 = as many as are left (MAX), otherwise 1-3."
    },
    { "key": "batch_rotate", "type": "bool", "default": false, "description": "Run only one of the chosen batch sweep presets a day, in turn (a plan per day)." },
    {
      "key": "batch_only_campaign",
      "type": "bool",
      "default": false,
      "description": "Batch sweep only while the mission page shows a campaign bonus."
    },
    {
      "key": "sweep_runs",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 50,
      "description": "Sweeps per stage: 0 = as many as possible (MAX), otherwise that number."
    },
    {
      "key": "stage",
      "type": "choice",
      "default": "highest",
      "choices": ["highest", "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
      "description": "Campaign mission stage of the shown area: 'highest' or its number."
    }
  ],
  "steps": [
    { "action": "goto", "page": "mission_area" },
    { "action": "read_number", "roi": { "x": 500, "y": 8, "w": 105, "h": 30 }, "store": "ap", "optional": true },
    {
      "action": "if",
      "when": { "value": "ap", "lt": 20 },
      "then": [{ "action": "return_home" }, { "action": "end", "status": "skipped", "message": "not enough AP" }]
    },
    {
      "action": "loop",
      "max": 1,
      "steps": [
        {
          "action": "if",
          "when": { "setting": "batch_only_campaign", "equals": true },
          "then": [
            {
              "action": "if",
              "when": { "absent": { "template": "mission_campaign_tag.png", "roi": { "x": 90, "y": 225, "w": 140, "h": 65 }, "threshold": 0.9 } },
              "then": [{ "action": "break" }]
            }
          ]
        },
        {
          "action": "each",
          "setting": "batch_presets", "rotate_setting": "batch_rotate",
          "steps": [
            {
              "action": "if",
              "when": { "absent": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 } },
              "then": [
                {
                  "action": "click",
                  "x": 535,
                  "y": 588,
                  "on_page": "mission_area",
                  "expect": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "timeout_ms": 5000
                },
                { "action": "wait_stable", "timeout_ms": 3000 }
              ]
            },
            {
              "action": "click",
              "points": [
                { "x": 123, "y": 163 },
                { "x": 282, "y": 163 },
                { "x": 441, "y": 163 },
                { "x": 600, "y": 163 },
                { "x": 759, "y": 163 },
                { "x": 918, "y": 163 },
                { "x": 1077, "y": 163 }
              ],
              "point_by": "value",
              "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
              "no_verify": true
            },
            { "action": "wait_stable", "timeout_ms": 3000 },
            {
              "action": "if",
              "when": {
                "no_color": { "hsv_min": [100, 80, 40], "hsv_max": [125, 255, 120], "area": [600, 3000] },
                "roi_by_value": [
                  { "x": 93, "y": 150, "w": 60, "h": 26 },
                  { "x": 252, "y": 150, "w": 60, "h": 26 },
                  { "x": 411, "y": 150, "w": 60, "h": 26 },
                  { "x": 570, "y": 150, "w": 60, "h": 26 },
                  { "x": 729, "y": 150, "w": 60, "h": 26 },
                  { "x": 888, "y": 150, "w": 60, "h": 26 },
                  { "x": 1047, "y": 150, "w": 60, "h": 26 }
                ]
              },
              "then": [
                {
                  "action": "click",
                  "x": 1221,
                  "y": 99,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "expect": { "template": "mission_area_title.png", "roi": { "x": 80, "y": 0, "w": 110, "h": 55 }, "threshold": 0.95 },
                  "timeout_ms": 5000
                },
                { "action": "fail", "message": "the batch sweep preset could not be selected" }
              ]
            },
            {
              "action": "if",
              "when": { "setting": "batch_runs", "equals": 0 },
              "then": [
                {
                  "action": "click",
                  "x": 818,
                  "y": 592,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "no_verify": true
                }
              ],
              "else": [
                {
                  "action": "click",
                  "x": 530,
                  "y": 591,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "no_verify": true
                }
              ]
            },
            { "action": "sleep", "sleep_ms": 600 },
            {
              "action": "if",
              "when": { "setting": "batch_runs", "equals": 2 },
              "then": [
                {
                  "action": "click",
                  "x": 751,
                  "y": 592,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "no_verify": true
                }
              ]
            },
            {
              "action": "if",
              "when": { "setting": "batch_runs", "equals": 3 },
              "then": [
                {
                  "action": "click",
                  "x": 751,
                  "y": 592,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "no_verify": true
                },
                { "action": "sleep", "sleep_ms": 400 },
                {
                  "action": "click",
                  "x": 751,
                  "y": 592,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "no_verify": true
                }
              ]
            },
            { "action": "sleep", "sleep_ms": 800 },
            {
              "action": "if",
              "when": {
                "color": { "hsv_min": [18, 120, 180], "hsv_max": [35, 255, 255], "area": [5000, 14000], "roi": { "x": 1000, "y": 565, "w": 225, "h": 60 } }
              },
              "then": [
                {
                  "action": "click",
                  "x": 1112,
                  "y": 592,
                  "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "expect": { "template": "mission_batch_confirm_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "timeout_ms": 5000
                },
                {
                  "action": "click",
                  "x": 767,
                  "y": 585,
                  "require": { "template": "mission_batch_confirm_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
                  "no_verify": true
                },
                { "action": "sleep", "sleep_ms": 3000 },
                {
                  "action": "loop",
                  "max": 20,
                  "until": { "present": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 } },
                  "steps": [{ "action": "sleep", "sleep_ms": 2000 }]
                },
                { "action": "wait_stable", "timeout_ms": 4000 }
              ]
            }
          ]
        }
      ]
    },
    {
      "action": "if",
      "when": { "present": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 } },
      "then": [
        {
          "action": "click",
          "x": 1221,
          "y": 99,
          "require": { "template": "mission_batch_title.png", "roi": { "x": 550, "y": 70, "w": 180, "h": 70 }, "threshold": 0.9 },
          "expect": { "template": "mission_area_title.png", "roi": { "x": 80, "y": 0, "w": 110, "h": 55 }, "threshold": 0.95 },
          "timeout_ms": 5000
        },
        { "action": "wait_stable", "timeout_ms": 3000 },
        { "action": "read_number", "roi": { "x": 500, "y": 8, "w": 105, "h": 30 }, "store": "ap", "optional": true },
        {
          "action": "if",
          "when": { "value": "ap", "lt": 20 },
          "then": [{ "action": "return_home" }, { "action": "end", "status": "succeeded", "message": "batch sweep done, AP left for nothing else" }]
        }
      ]
    },
    {
      "action": "if",
      "when": { "setting": "stage", "equals": "highest" },
      "then": [
        {
          "action": "click",
          "template": "stage_three_stars.png",
          "roi": { "x": 680, "y": 130, "w": 560, "h": 560 },
          "threshold": 0.9,
          "pick": "bottom",
          "offset": { "x": 397, "y": -16 },
          "expect": { "template": "popup_stage_info_title.png", "roi": { "x": 540, "y": 70, "w": 200, "h": 110 }, "threshold": 0.9 },
          "optional": true
        }
      ],
      "else": [
        {
          "action": "click_text",
          "text_setting": "stage",
          "roi": { "x": 690, "y": 130, "w": 90, "h": 560 },
          "click_x": 1117,
          "offset": { "x": 0, "y": 13 },
          "max_scrolls": 5,
          "duration_ms": 500,
          "optional": true,
          "from": { "x": 940, "y": 250 },
          "to": { "x": 940, "y": 560 }
        }
      ]
    },
    {
      "action": "if",
      "when": { "absent": { "template": "popup_stage_info_title.png", "roi": { "x": 540, "y": 70, "w": 200, "h": 110 }, "threshold": 0.9 } },
      "then": [{ "action": "return_home" }, { "action": "end", "status": "skipped", "message": "nothing to sweep here" }]
    },
    {
      "action": "click",
      "when": { "setting": "sweep_runs", "equals": 0 },
      "template": "stage_sweep_max.png",
      "roi": { "x": 1030, "y": 265, "w": 120, "h": 105 },
      "threshold": 0.9,
      "no_verify": true
    },
    {
      "action": "loop",
      "max_setting": "sweep_runs",
      "max_adjust": -1,
      "steps": [
        {
          "action": "click",
          "template": "stage_sweep_plus.png",
          "roi": { "x": 975, "y": 265, "w": 90, "h": 105 },
          "threshold": 0.9,
          "no_verify": true,
          "timeout_ms": 1500,
          "optional": true,
          "quiet": true
        }
      ]
    },
    {
      "action": "click",
      "template": "stage_sweep_start.png",
      "roi": { "x": 770, "y": 370, "w": 330, "h": 100 },
      "threshold": 0.9,
      "expect": { "template": "stage_sweep_confirm_question.png", "roi": { "x": 400, "y": 280, "w": 480, "h": 110 }, "threshold": 0.9 },
      "timeout_ms": 3000,
      "retries": 0,
      "optional": true
    },
    {
      "action": "if",
      "when": { "present": { "template": "stage_sweep_confirm_question.png", "roi": { "x": 400, "y": 280, "w": 480, "h": 110 }, "threshold": 0.9 } },
      "then": [
        {
          "action": "click",
          "template": "dialog_ok_button.png",
          "roi": { "x": 660, "y": 440, "w": 240, "h": 120 },
          "threshold": 0.9,
          "sleep_ms": 4000
        },
        {
          "action": "loop",
          "max": 10,
          "until": { "absent": { "template": "stage_sweep_confirm_question.png", "roi": { "x": 400, "y": 280, "w": 480, "h": 110 }, "threshold": 0.9 } },
          "steps": [{ "action": "wait_stable", "timeout_ms": 4000 }]
        },
        {
          "action": "wait_template",
          "template": "popup_stage_info_title.png",
          "roi": { "x": 540, "y": 70, "w": 200, "h": 110 },
          "threshold": 0.9,
          "timeout_ms": 30000
        }
      ],
      "else": [{ "action": "back" }, { "action": "wait_stable", "timeout_ms": 4000 }]
    },
    {
      "action": "back",
      "when": { "present": { "template": "popup_stage_info_title.png", "roi": { "x": 540, "y": 70, "w": 200, "h": 110 }, "threshold": 0.9 } }
    },
    { "action": "wait_stable", "timeout_ms": 4000 },
    { "action": "return_home" }
  ]
}
