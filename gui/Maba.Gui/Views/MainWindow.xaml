<hc:Window x:Class="Maba.Gui.Views.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:Maba.Gui.ViewModels"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d"
           d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
           Title="{Binding WindowTitle}"
           Width="880" Height="640" MinWidth="720" MinHeight="480"
           WindowStartupLocation="CenterScreen"
           ShowTitle="True">
    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="12,6" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding CoreVersion, StringFormat=Core {0}}" />
                <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{Binding NextRunText}" />
                <TextBlock DockPanel.Dock="Right" Margin="0,0,16,0">
                    <Hyperlink Command="{Binding OpenUpdateCommand}"><Run Text="{Binding UpdateText, Mode=OneWay}" /></Hyperlink>
                </TextBlock>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <TabControl Style="{StaticResource TabControlInLine}" Margin="8">
            <!-- Tasks -->
            <TabItem Header="{DynamicResource Tab.Tasks}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{DynamicResource Tasks.Start}" Command="{Binding StartCommand}"
                                Style="{StaticResource ButtonPrimary}" Width="120" />
                        <Button Content="{DynamicResource Tasks.Stop}" Command="{Binding StopCommand}"
                                Style="{StaticResource ButtonDanger}" Width="120" Margin="8,0,0,0" />
                        <Button Content="{DynamicResource Tasks.Reload}" Command="{Binding ReloadDataCommand}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Tasks.Hint}" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                               IsEnabled="{Binding IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}">
                        <TextBlock Text="{DynamicResource Profile.Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Width="150" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                  DisplayMemberPath="Name" />
                        <TextBox Width="150" Margin="8,0,0,0" Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{DynamicResource Profile.Rename}" />
                        <Button Content="{DynamicResource Profile.Add}" Command="{Binding AddProfileCommand}" Margin="8,0,0,0" />
                        <Button Content="{DynamicResource Profile.Delete}" Command="{Binding DeleteProfileCommand}" Margin="8,0,0,0" />
                        <Button Content="{DynamicResource Profile.ResetOrder}" Command="{Binding ResetOrderCommand}" Margin="8,0,0,0"
                                HorizontalAlignment="Left" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                                 PreviewDragOver="OnTaskListDragOver" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItemBaseStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskItemViewModel}">
                                    <Border Padding="6,6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                            AllowDrop="True" DragOver="OnTaskDragOver" DragLeave="OnTaskDragLeave" Drop="OnTaskDrop">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Margin="-4,0,6,0" Padding="2,4" Background="Transparent"
                                                    Cursor="SizeAll" ToolTip="{DynamicResource Tasks.Drag}"
                                                    AutomationProperties.Name="{DynamicResource Tasks.Drag}"
                                                    PreviewMouseLeftButtonDown="OnGripDown" PreviewMouseMove="OnGripMove"
                                                    IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Boolean2BooleanReConverter}}">
                                                <Path Width="12" Height="18" Stretch="Uniform" Fill="{DynamicResource SecondaryTextBrush}" Data="M9 5A1.5 1.5 0 1 1 9 8A1.5 1.5 0 1 1 9 5ZM15 5A1.5 1.5 0 1 1 15 8A1.5 1.5 0 1 1 15 5ZM9 10.5A1.5 1.5 0 1 1 9 13.5A1.5 1.5 0 1 1 9 10.5ZM15 10.5A1.5 1.5 0 1 1 15 13.5A1.5 1.5 0 1 1 15 10.5ZM9 16A1.5 1.5 0 1 1 9 19A1.5 1.5 0 1 1 9 16ZM15 16A1.5 1.5 0 1 1 15 19A1.5 1.5 0 1 1 15 16Z" />
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ShortStatus}" />
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                      IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Boolean2BooleanReConverter}}" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Right: the chosen task, or today's summary -->
                        <Border Grid.Column="2" Padding="16" CornerRadius="4" Background="{DynamicResource RegionBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <hc:ScrollViewer Visibility="{Binding DataContext.HasSelectedTask, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Boolean2VisibilityConverter}}"
                                                 DataContext="{Binding SelectedTask}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{DynamicResource Summary.Back}" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.ClearSelectedTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Style="{StaticResource TextBlockSubTitleBold}" HorizontalAlignment="Left"
                                                       TextWrapping="Wrap" Text="{Binding Name}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Id}" />
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0"
                                                       Visibility="{Binding After, Converter={StaticResource String2VisibilityConverter}}">
                                                <Run Text="{DynamicResource Tasks.After}" />: <Run Text="{Binding After, Mode=OneWay}" />
                                            </TextBlock>
                                            <Border Margin="8,0,0,0" Padding="4,0" CornerRadius="2" Background="{DynamicResource SecondaryRegionBrush}"
                                                    Visibility="{Binding NeedsOcr, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                <TextBlock Text="{DynamicResource Tasks.Ocr}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="4" Background="{DynamicResource DangerBrush}"
                                                Visibility="{Binding Warning, Converter={StaticResource String2VisibilityConverter}}">
                                            <TextBlock Foreground="White" TextWrapping="Wrap" Text="{Binding Warning}" />
                                        </Border>
                                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Description}"
                                                   Visibility="{Binding Description, Converter={StaticResource String2VisibilityConverter}}" />

                                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{DynamicResource Tasks.Settings}" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Tasks.NoSettings}"
                                                   Visibility="{Binding HasSettings, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                                        <ItemsControl ItemsSource="{Binding Settings}" Margin="0,4,0,0"
              IsEnabled="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Boolean2BooleanReConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SettingItemViewModel}">
                                                        <!-- One row per setting, with a line under it so label and control read as a pair. -->
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Left" Width="240" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                       TextWrapping="Wrap" Text="{Binding Label}" />
                                                            <Grid>
                                                                <CheckBox IsChecked="{Binding BoolValue}" HorizontalAlignment="Left"
                                                                          Visibility="{Binding IsBool, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                                <hc:NumericUpDown Value="{Binding IntValue}" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                                                  Increment="1" DecimalPlaces="0" Width="120" HorizontalAlignment="Left"
                                                                                  Visibility="{Binding IsInt, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}"
                                                                          Width="160" HorizontalAlignment="Left"
                                                                          Visibility="{Binding IsChoice, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                                <ItemsControl ItemsSource="{Binding Items}"
                                                                              Visibility="{Binding IsChecklist, Converter={StaticResource Boolean2VisibilityConverter}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="{x:Type vm:ChecklistItem}">
                                                                            <!-- The cell keeps the columns aligned; only the box and its label take the click. -->
                                                                            <Border MinWidth="150" Margin="0,0,12,4">
                                                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBox Text="{Binding ListText, UpdateSourceTrigger=LostFocus}"
                                                                         hc:InfoElement.Placeholder="{Binding ListHint}" ToolTip="{Binding ListHint}"
                                                                         Visibility="{Binding IsList, Converter={StaticResource Boolean2VisibilityConverter}}" />
                                                            </Grid>
                                                        </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{DynamicResource Tasks.LastResult}" />
                                        <TextBlock TextWrapping="Wrap" Text="{Binding StatusText}"
                                                   Visibility="{Binding StatusText, Converter={StaticResource String2VisibilityConverter}}" />
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding LastResult}"
                                                   Visibility="{Binding LastResult, Converter={StaticResource String2VisibilityConverter}}" />
                                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{DynamicResource Tasks.NoResult}"
                                                   Visibility="{Binding LastResult, Converter={StaticResource String2VisibilityReConverter}}" />
                                    </StackPanel>
                                </hc:ScrollViewer>
                                <StackPanel Visibility="{Binding HasSelectedTask, Converter={StaticResource Boolean2VisibilityReConverter}}">
                                    <TextBlock Style="{StaticResource TextBlockSubTitleBold}" HorizontalAlignment="Left" Text="{DynamicResource Summary.Title}" />
                                    <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="{DynamicResource Summary.NextRun}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding NextRunText}" />
                                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{DynamicResource Summary.Account}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SummaryAccount}" />
                                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{DynamicResource Summary.LastRun}" />
                                    <TextBlock TextWrapping="Wrap" Text="{Binding SummaryLastRun}" />
                                    <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                               Text="{DynamicResource Summary.Pick}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- My info: one box per account record -->
            <TabItem Header="{DynamicResource Tab.Account}">
                <hc:ScrollViewer>
                    <StackPanel Margin="12">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Account.Empty}"
                                   Visibility="{Binding HasAccounts, Converter={StaticResource Boolean2VisibilityReConverter}}" />
                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="260" Margin="0,0,12,12" Padding="14" CornerRadius="6"
                                            Background="{DynamicResource RegionBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.ColumnSpan="2" Style="{StaticResource TextBlockSubTitleBold}" Margin="0,0,32,0"
                                                       HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Nickname}" />
                                            <Button Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Width="28" Height="28" Padding="5"
                                                    Style="{StaticResource ButtonIcon}" Foreground="{DynamicResource DangerBrush}"
                                                    hc:IconElement.Geometry="M9 3V4H4V6H5V20A2 2 0 0 0 7 22H17A2 2 0 0 0 19 20V6H20V4H15V3H9M7 6H17V20H7V6M9 8V18H11V8H9M13 8V18H15V8H13Z"
                                                    ToolTip="{DynamicResource Account.Delete}"
                                                    AutomationProperties.Name="{DynamicResource Account.Delete}"
                                                    Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{DynamicResource Account.Uid}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding Uid}" />
                                            <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="{DynamicResource Account.Level}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Level}" />
                                            <TextBlock Grid.Row="3" Margin="0,4,0,0" Text="{DynamicResource Account.Ap}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Ap}" />
                                            <TextBlock Grid.Row="4" Margin="0,4,0,0" Text="{DynamicResource Account.Credits}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Credits}" />
                                            <TextBlock Grid.Row="5" Margin="0,4,0,0" Text="{DynamicResource Account.Pyroxene}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,0,0" Text="{Binding Pyroxene}" />
                                            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,0" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Text="{Binding Updated}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </hc:ScrollViewer>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="{DynamicResource Tab.Settings}">
                <hc:ScrollViewer>
                    <StackPanel Margin="12" MaxWidth="640" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource Boolean2BooleanReConverter}}">
                        <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.UiLanguage}"
                                     hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                     ItemsSource="{Binding UiLanguageChoices}" DisplayMemberPath="Label"
                                     SelectedValuePath="Value" SelectedValue="{Binding UiLanguage}" />
                        <TextBlock Margin="140,4,0,16" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource Settings.UiLanguageHint}" />

                        <TextBlock Style="{StaticResource TextBlockSubTitleBold}" HorizontalAlignment="Left"
                                   Text="{DynamicResource Settings.Connection}" Margin="0,0,0,8" />
                        <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.Controller}"
                                     hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                     ItemsSource="{Binding Controllers}" DisplayMemberPath="Label"
                                     SelectedValuePath="Value" SelectedValue="{Binding Controller}" Margin="0,0,0,8" />

                        <StackPanel Visibility="{Binding IsSteam, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.Capture}"
                                         hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                         ItemsSource="{Binding CaptureMethods}" DisplayMemberPath="Label"
                                         SelectedValuePath="Value" SelectedValue="{Binding Capture}" />
                            <TextBlock Margin="140,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Settings.CaptureHint}" />
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.FitWindow}" IsChecked="{Binding FitWindow}" Margin="0,0,0,8" />

                            <TextBlock Style="{StaticResource TextBlockSubTitleBold}" HorizontalAlignment="Left"
                                       Text="{DynamicResource Settings.Launch}" Margin="0,8,0,8" />
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.SteamStartGame}" IsChecked="{Binding SteamStartGame}"
                                      Margin="0,0,0,8" />
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.CloseGameAfter}" IsChecked="{Binding SteamCloseGame}"
                                      Margin="0,0,0,4" />
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Settings.SteamLaunchHint}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsAdb, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <hc:TextBox hc:InfoElement.Title="{DynamicResource Settings.AdbPath}"
                                        hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                        Text="{Binding AdbPath, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="{DynamicResource Settings.FindDevices}"
                                        Command="{Binding RefreshDevicesCommand}" />
                                <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.AdbSerial}"
                                             hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                             IsEditable="True" ItemsSource="{Binding AdbDevices}"
                                             Text="{Binding AdbSerial, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>
                            <TextBlock Margin="140,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Settings.AdbSerialHint}" />
                            <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.Screencap}"
                                         hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                         ItemsSource="{Binding ScreencapMethods}" DisplayMemberPath="Label"
                                         SelectedValuePath="Value" SelectedValue="{Binding AdbScreencap}" Margin="0,0,0,8" />
                            <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.Touch}"
                                         hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                         ItemsSource="{Binding TouchMethods}" DisplayMemberPath="Label"
                                         SelectedValuePath="Value" SelectedValue="{Binding AdbTouch}" Margin="0,0,0,8" />
                            <hc:TextBox hc:InfoElement.Title="{DynamicResource Settings.MaaTouchPath}"
                                        hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                        Text="{Binding MaaTouchPath, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                            <hc:NumericUpDown hc:InfoElement.Title="{DynamicResource Settings.BackKeycode}"
                                              hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                              Minimum="1" Maximum="300" Value="{Binding BackKeycode}"
                                              Style="{StaticResource NumericUpDownExtend}" />
                            <TextBlock Margin="140,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Settings.BackKeycodeHint}" />

                            <TextBlock Style="{StaticResource TextBlockSubTitleBold}" HorizontalAlignment="Left"
                                       Text="{DynamicResource Settings.Launch}" Margin="0,8,0,8" />
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.StartEmulator}" IsChecked="{Binding StartEmulator}"
                                      Margin="0,0,0,8" />
                            <StackPanel IsEnabled="{Binding StartEmulator}">
                                <hc:TextBox hc:InfoElement.Title="{DynamicResource Settings.EmulatorPath}"
                                            hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                            Text="{Binding EmulatorPath, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8" />
                                <hc:TextBox hc:InfoElement.Title="{DynamicResource Settings.EmulatorArgs}"
                                            hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                            Text="{Binding EmulatorArgs, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Margin="140,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Text="{DynamicResource Settings.EmulatorPathHint}" />
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.StartGame}" IsChecked="{Binding StartGame}"
                                      Margin="0,0,0,8" />
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.CloseGameAfter}" IsChecked="{Binding CloseGameAfter}"
                                      Margin="0,0,0,8" />
                            <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.CloseEmulatorAfter}" IsChecked="{Binding CloseEmulatorAfter}"
                                      Margin="0,0,0,4" />
                            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Settings.LaunchHint}" />
                        </StackPanel>

                        <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.CheckUpdates}" IsChecked="{Binding CheckUpdates}" Margin="0,0,0,8" />
                        <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.Ocr}" IsChecked="{Binding OcrEnabled}" Margin="0,4,0,8" />
                        <hc:TextBox hc:InfoElement.Title="{DynamicResource Settings.DataRoot}"
                                    hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                    Text="{Binding DataRoot, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource TextBlockSubTitleBold}" HorizontalAlignment="Left"
                                   Text="{DynamicResource Settings.Schedule}" Margin="0,0,0,8" />
                        <CheckBox HorizontalAlignment="Left" Content="{DynamicResource Settings.ScheduleEnabled}" IsChecked="{Binding ScheduleEnabled}"
                                  Margin="0,0,0,8" />
                        <hc:ComboBox hc:InfoElement.Title="{DynamicResource Settings.ScheduleMode}"
                                     hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                     ItemsSource="{Binding ScheduleModes}" DisplayMemberPath="Label"
                                     SelectedValuePath="Value" SelectedValue="{Binding ScheduleMode}" Margin="0,0,0,8" />
                        <StackPanel Visibility="{Binding IsClockSchedule, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource Settings.ClockTime}" />
                                <hc:NumericUpDown Width="90" Minimum="0" Maximum="23" Value="{Binding ScheduleHour}" />
                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text=":" />
                                <hc:NumericUpDown Width="90" Minimum="0" Maximum="59" Value="{Binding ScheduleMinute}" />
                            </StackPanel>
                            <TextBlock Margin="140,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Text="{DynamicResource Settings.ClockHint}" />
                            <TextBlock Margin="140,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding ScheduleWarning}"
                                       Visibility="{Binding ScheduleWarning, Converter={StaticResource String2VisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Width="140" VerticalAlignment="Center" Text="{DynamicResource Settings.ResetTime}" />
                            <hc:NumericUpDown Width="90" Minimum="0" Maximum="23" Value="{Binding ResetHourUtc}" />
                            <TextBlock Margin="6,0" VerticalAlignment="Center" Text=":" />
                            <hc:NumericUpDown Width="90" Minimum="0" Maximum="59" Value="{Binding ResetMinuteUtc}" />
                        </StackPanel>
                        <TextBlock Margin="140,0,0,8" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ResetLocalText}" />
                        <hc:NumericUpDown hc:InfoElement.Title="{DynamicResource Settings.Delay}"
                                          hc:InfoElement.TitlePlacement="Left" hc:InfoElement.TitleWidth="140"
                                          Minimum="0" Maximum="600" Value="{Binding DelayMinutes}"
                                          Visibility="{Binding IsResetSchedule, Converter={StaticResource Boolean2VisibilityConverter}}"
                                          Style="{StaticResource NumericUpDownExtend}" Margin="0,0,0,8" />
                        <Border Height="8" />

                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{DynamicResource About.Disclaimer}" />
                    </StackPanel>
                </hc:ScrollViewer>
            </TabItem>

            <!-- Log -->
            <TabItem Header="{DynamicResource Tab.Log}">
                <DockPanel Margin="8">
                    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Content="{DynamicResource Log.Clear}" Command="{Binding ClearLogCommand}" />
                    <ListBox x:Name="LogList" ItemsSource="{Binding Log}" VirtualizingPanel.IsVirtualizing="True" IsVisibleChanged="OnLogVisibleChanged"
                             FontFamily="Consolas, Malgun Gothic">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Run Text="{Binding Level, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                                    <Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</hc:Window>
