<!-- GUI text, Korean (baseline). Keys are shared by every Strings.<lang>.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="App.Title">MABA - 블루 아카이브 일일 숙제 도우미</sys:String>

    <sys:String x:Key="Tab.Tasks">숙제</sys:String>
    <sys:String x:Key="Tab.Settings">설정</sys:String>
    <sys:String x:Key="Tab.Log">로그</sys:String>

    <sys:String x:Key="Tasks.Header">실행할 숙제</sys:String>
    <sys:String x:Key="Tasks.Start">시작</sys:String>
    <sys:String x:Key="Tasks.Stop">중지</sys:String>
    <sys:String x:Key="Tasks.Reload">데이터 다시 읽기</sys:String>
    <sys:String x:Key="Tasks.After">선행</sys:String>
    <sys:String x:Key="Tasks.Ocr">OCR</sys:String>
    <sys:String x:Key="Tasks.Hint">순서는 숙제 정의의 선행 관계로 정해집니다. 우편함은 활동력 소비 뒤에 실행됩니다.</sys:String>
    <sys:String x:Key="Task.NotImplemented">아직 구현되지 않음</sys:String>
    <!-- Display names by task id (tasks/*.json); a missing id falls back to the task's own name. -->
    <sys:String x:Key="Task.cafe">카페: 입장, 수익 수령, 학생 터치</sys:String>
    <sys:String x:Key="Task.schedule">스케줄: 입장, 티켓 소비</sys:String>
    <sys:String x:Key="Task.shop">상점: 일일 구매</sys:String>
    <sys:String x:Key="Task.spend_ap">활동력 소비 (이벤트 맵, 배수 이벤트)</sys:String>
    <sys:String x:Key="Task.mail_claim_all">우편함: 모두 받기</sys:String>
    <sys:String x:Key="Task.mission_claim_all">미션: 일일 미션 모두 받기</sys:String>

    <sys:String x:Key="Status.pending">대기</sys:String>
    <sys:String x:Key="Status.running">실행 중</sys:String>
    <sys:String x:Key="Status.succeeded">완료</sys:String>
    <sys:String x:Key="Status.failed">실패</sys:String>
    <sys:String x:Key="Status.skipped">건너뜀</sys:String>
    <sys:String x:Key="Status.cancelled">취소됨</sys:String>
    <sys:String x:Key="Status.Ready">준비됨</sys:String>
    <sys:String x:Key="Status.Connecting">연결 중...</sys:String>
    <sys:String x:Key="Status.ConnectFailed">연결 실패 (로그 확인)</sys:String>
    <sys:String x:Key="Status.StartFailed">시작 실패 (로그 확인)</sys:String>
    <sys:String x:Key="Status.Running">실행 중</sys:String>
    <sys:String x:Key="Status.RunningScheduled">예약 실행 중</sys:String>
    <sys:String x:Key="Status.Stopping">중지하는 중...</sys:String>
    <sys:String x:Key="Status.Finished">모든 숙제 완료</sys:String>
    <sys:String x:Key="Status.FinishedWithErrors">일부 숙제 실패 (로그 확인)</sys:String>
    <sys:String x:Key="Status.Cancelled">중지됨</sys:String>
    <sys:String x:Key="Status.CoreMissing">MabaCore.dll을 불러오지 못했습니다. 코어를 먼저 빌드하세요 (gui/README.md).</sys:String>
    <sys:String x:Key="Status.DataError">데이터 오류 (로그 확인)</sys:String>

    <sys:String x:Key="Settings.Connection">연결</sys:String>
    <sys:String x:Key="Settings.Controller">대상</sys:String>
    <sys:String x:Key="Settings.Controller.Steam">스팀 PC 클라이언트</sys:String>
    <sys:String x:Key="Settings.Controller.Adb">에뮬레이터 (ADB)</sys:String>
    <sys:String x:Key="Settings.Capture">캡처 방식</sys:String>
    <sys:String x:Key="Settings.CaptureHint">BitBlt: 빠르지만 게임 창이 가려지면 안 됩니다. PrintWindow: 가려져도 동작하지만 검은 화면이 나올 수 있습니다.</sys:String>
    <sys:String x:Key="Settings.AdbPath">adb 경로</sys:String>
    <sys:String x:Key="Settings.AdbSerial">기기 주소</sys:String>
    <sys:String x:Key="Settings.AdbSerialHint">MuMu 12: 127.0.0.1:16384, LDPlayer: emulator-5554, BlueStacks: 127.0.0.1:5555 (확인 필요)</sys:String>
    <sys:String x:Key="Settings.FindDevices">기기 찾기</sys:String>
    <sys:String x:Key="Settings.Screencap">화면 캡처</sys:String>
    <sys:String x:Key="Settings.Touch">입력 방식</sys:String>
    <sys:String x:Key="Settings.MaaTouchPath">MaaTouch 파일</sys:String>
    <sys:String x:Key="Settings.BackKeycode">뒤로 키 코드</sys:String>
    <sys:String x:Key="Settings.BackKeycodeHint">111 = ESC, 4 = BACK. 게임에서 어느 쪽이 뒤로 가기인지 확인하세요.</sys:String>
    <sys:String x:Key="Settings.Auto">자동 (빠른 쪽)</sys:String>
    <sys:String x:Key="Settings.Ocr">OCR 사용 (ocr/.venv의 RapidOCR 사이드카)</sys:String>
    <sys:String x:Key="Settings.DataRoot">데이터 폴더</sys:String>
    <sys:String x:Key="Settings.Schedule">예약 실행</sys:String>
    <sys:String x:Key="Settings.ScheduleEnabled">매일 서버 초기화 후 자동 실행</sys:String>
    <sys:String x:Key="Settings.ResetTime">서버 초기화 시각 (UTC)</sys:String>
    <sys:String x:Key="Settings.ResetLocal">현지 시각 {0} (기본값 04:00 KST는 확인 필요)</sys:String>
    <sys:String x:Key="Settings.Delay">초기화 후 대기 (분)</sys:String>

    <sys:String x:Key="Schedule.Off">예약 꺼짐</sys:String>
    <sys:String x:Key="Schedule.Next">다음 예약 실행: {0}</sys:String>
    <sys:String x:Key="Schedule.Invalid">예약 설정이 올바르지 않습니다</sys:String>

    <sys:String x:Key="Log.Clear">지우기</sys:String>
    <sys:String x:Key="Log.SaveFailed">설정을 저장하지 못했습니다.</sys:String>
    <sys:String x:Key="Log.NoDevices">연결된 기기가 없습니다.</sys:String>
    <sys:String x:Key="Log.FailureFrame">실패 화면 저장: {0}</sys:String>
    <sys:String x:Key="Log.ScheduledStart">예약된 시각이 되어 숙제를 시작합니다.</sys:String>

    <sys:String x:Key="About.Disclaimer">이 도구는 화면 인식과 일반 입력만 사용합니다. 자동화 도구 사용은 게임 이용약관에 위반될 수 있으며, 그 위험은 사용자에게 있습니다.</sys:String>
</ResourceDictionary>
