<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Maba.Gui</RootNamespace>
    <AssemblyName>MabaAssistantBlueArchive</AssemblyName>
    <Product>MabaAssistantBlueArchive</Product>
    <Copyright>2026 MabaAssistantBlueArchive contributors (AGPL-3.0-only)</Copyright>
    <Version>0.2.0</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(MabaRepository)' != ''">
    <AssemblyMetadata Include="Repository" Value="$(MabaRepository)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versions pinned; licenses in THIRD_PARTY_NOTICES.md and the README library table. -->
    <PackageReference Include="HandyControls" Version="3.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- Native Core: MabaCore.dll and its runtime DLLs from the CMake build (windows-msvc preset).
       Override with -p:MabaCoreDir=... when the build lives elsewhere. -->
  <PropertyGroup>
    <MabaCoreDir Condition="'$(MabaCoreDir)' == ''">$(MSBuildThisFileDirectory)..\..\build\windows-msvc\core\Release\</MabaCoreDir>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(MabaCoreDir)MabaCore.dll')">
    <None Include="$(MabaCoreDir)*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Visible="false" />
  </ItemGroup>

</Project>
