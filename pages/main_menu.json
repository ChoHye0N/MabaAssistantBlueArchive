{
  "id": "main_menu",
  "notes": [
    "Home page of the Navigator. Capture main_menu_mail_icon.png and main_menu_mission_icon.png with tools/template_capture.py (lang common) and copy their roi here, enlarged by a margin.",
    "verify: the mail and mission buttons keep their positions on the main screen across events and UI scales.",
    "Detected only when the mail icon (top bar), the mission icon (left column) and the shop icon (bottom bar) all match.",
    "enter: start-up screens before the main screen (title, event countdown splash, attendance board) are tapped through at a point that is only character art on the main screen. Login popups are closed by popups/ first."
  ],
  "anchors": [
    { "template": "main_menu_mail_icon.png", "roi": { "x": 1110, "y": 0, "w": 90, "h": 70 }, "threshold": 0.9 },
    { "template": "main_menu_mission_icon.png", "roi": { "x": 14, "y": 190, "w": 70, "h": 75 }, "threshold": 0.9 },
    { "template": "main_menu_shop_icon.png", "roi": { "x": 725, "y": 615, "w": 90, "h": 85 }, "threshold": 0.9 }
  ],
  "enter": { "tap": { "x": 640, "y": 100 }, "max_taps": 30, "interval_ms": 2000 },
  "transitions": [
    { "to": "attendance", "click": { "template": "main_menu_attendance_icon.png", "roi": { "x": 170, "y": 90, "w": 110, "h": 90 }, "threshold": 0.9 } },
    { "to": "battle_pass", "click": { "template": "battle_pass_badge.png", "roi": { "x": 290, "y": 500, "w": 130, "h": 70 }, "threshold": 0.9 } },
    { "to": "mail", "click": { "template": "main_menu_mail_icon.png", "roi": { "x": 1110, "y": 0, "w": 90, "h": 70 }, "threshold": 0.9 } },
    { "to": "mission", "click": { "template": "main_menu_mission_icon.png", "roi": { "x": 14, "y": 190, "w": 70, "h": 75 }, "threshold": 0.9 } },
    { "to": "gem_shop", "click": { "x": 133, "y": 228 } },
    { "to": "cafe", "click": { "x": 100, "y": 650 } },
    { "to": "schedule", "click": { "x": 210, "y": 650 } },
    { "to": "social_menu", "click": { "x": 541, "y": 650 } },
    { "to": "shop", "click": { "x": 765, "y": 650 } },
    { "to": "craft", "click": { "x": 655, "y": 650 } },
    { "to": "campaign", "click": { "x": 1200, "y": 670 } },
    { "to": "account", "click": { "x": 150, "y": 45 } }
  ]
}
